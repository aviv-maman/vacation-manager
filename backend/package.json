{
  "name": "vacation-manager-backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "codegen": "cef-gen-handlers",
    "type-check": "npm run codegen && tsc --noEmit",
    "build": "npm run type-check && cef-build --skip-codegen",
    "dev": "npm run build && npm start",
    "start": "node dist/index.js --local",
    "lint": "eslint src",
    "migration:run": "node --env-file-if-exists=.env --import tsx src/database/migrate.ts run",
    "migration:revert": "node --env-file-if-exists=.env --import tsx src/database/migrate.ts revert",
    "seed": "node --env-file-if-exists=.env --import tsx src/database/seed.ts",
    "pretest": "npm run codegen",
    "test": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run",
    "format": "prettier --write .. --ignore-path ../.prettierignore",
    "format:check": "prettier --check .. --ignore-path ../.prettierignore"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "commoneventframework": "^1.0.19",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "prettier": "3.9.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
