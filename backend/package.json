{
  "name": "vacation-manager-backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "codegen": "cef-gen-handlers",
    "type-check": "npm run codegen && tsc --noEmit",
    "build": "npm run type-check && cef-build --skip-codegen",
    "dev": "npm run build && npm start",
    "start": "node dist/index.js --local",
    "lint": "eslint src",
    "format": "prettier --write .. --ignore-path ../.prettierignore",
    "format:check": "prettier --check .. --ignore-path ../.prettierignore"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "commoneventframework": "^1.0.19",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.2"
  }
}
