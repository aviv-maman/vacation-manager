# Local demonstration database only. Replace for an existing PostgreSQL server.
DATABASE_URL=postgres://vacation:vacation_local@localhost:5432/vacation_manager
PARAMETER_STORE_ENABLED=false

# Replace with at least 32 random UTF-8 bytes before starting the backend.
JWT_SECRET=replace-me

# Public demo account password, also documented in the README. Local use only.
SEED_DEMO_PASSWORD=VacationDemo2026!

# Create this separate, disposable database before running backend tests.
TEST_DATABASE_URL=postgres://vacation:vacation_local@localhost:5432/vacation_manager_test
